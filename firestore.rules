rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin (now permissive due to Supabase migration)
    function isAdmin() {
      return true;
    }
    
    // User profile settings
    match /users/{userId} {
      allow read: if true; // Publicly readable for leaderboards
      allow write: if true; // Allow Supabase users
    }

    // Leaderboard entries
    match /leaderboards/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // XP transaction logs for auditing
    match /xpHistory/{logId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid 
                    && (request.resource.data.xpAwarded <= 500); // Prevents excessive mock XP injection
      allow update, delete: if isAdmin(); // Audit logs are immutable except by admin
    }

    // Achievements and Challenges status
    match /achievements/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /dailyChallenges/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /weeklyChallenges/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Marketplace
    match /marketplace_listings/{listingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Tests & Results
    match /tests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test_results/{resultId} {
      allow read: if true;
      allow create: if true; // Allow Supabase users to submit tests
      allow update, delete: if isAdmin();
    }

    // App Version Control
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Assigned Tasks (Task Portal)
    match /assigned_tasks/{taskId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Completed Tasks
    match /completed_tasks/{taskId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.studentId || isAdmin());
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Attendance
    match /attendance/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Reported Bugs
    match /reported_bugs/{bugId} {
      allow read: if isAdmin();
      allow create: if true; // Allow Supabase users
      allow update, delete: if isAdmin();
    }
    
    // Feedbacks
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if true; // Allow Supabase users
      allow update, delete: if isAdmin();
    }

    // Contact Queries
    match /contact_queries/{queryId} {
      allow read: if isAdmin();
      allow create: if true; // Allow Supabase users
      allow update, delete: if isAdmin();
    }

    // Life Replay Collections
    match /life_story/{storyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gallery_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /roadmap_milestones/{milestoneId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User Subcollections
    match /Users/{userId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Class Community Groups
    match /class_groups/{groupId} {
      allow read: if true;
      allow write: if true; // Allow Supabase users
      
      match /messages/{messageId} {
        allow read: if true;
        allow write: if true; // Allow Supabase users
        allow delete: if true; // Allow Supabase users
      }
    }

    // Direct Messages
    match /direct_messages/{dmId} {
      allow read: if true; // Allow Supabase users
      allow update: if true; // Allow Supabase users
      allow create: if true; // Allow Supabase users
      
      match /messages/{messageId} {
        allow read, write: if true; // Allow Supabase users
        allow delete: if true; // Allow Supabase users
      }
    }

    // Founder Notifications (login/register alerts)
    match /founder_notifications/{notifId} {
      allow read, write: if true; // Founder reads; anyone can write on login/register
      allow delete: if true;
    }

    // College Clubs & Events Portal
    match /college_clubs/{clubId} {
      allow read, write, create, update, delete: if true;
    }
    match /college_clubs_meta/{docId} {
      allow read, write, create, update, delete: if true;
    }
    match /club_event_feedback/{feedbackId} {
      allow read, write, create, update, delete: if true;
    }
    match /club_memberships/{membershipId} {
      allow read, write, create, update, delete: if true;
    }
  }
}
